{
  "rules": [
    {
      "allowed": {
        "origins": ["https://highline-freestyle-battles.highlinefreestyle.workers.dev"],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Content-Type", "Range"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range"],
      "maxAgeSeconds": 3600
    }
  ]
}
